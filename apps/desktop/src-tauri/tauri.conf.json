{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Video Factory",
  "version": "1.0.0",
  "identifier": "vn.taki.aivideofactory",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Video Factory",
        "url": "index.html",
        "width": 1600,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 760,
        "center": true,
        "backgroundColor": "#090e22"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Video",
    "shortDescription": "Sản xuất biến thể video bằng AI local",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
