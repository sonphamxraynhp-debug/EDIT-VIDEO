# KHÔNG BẮT BUỘC: agent mặc định dùng Claude Code (gói Claude Pro/Max), không tốn tiền API.
# Chỉ điền khi đặt llm.backend: api trong config.yaml
ANTHROPIC_API_KEY=
# Chỉ cần khi video.backend = veo_api
GEMINI_API_KEY=
# Chỉ cần khi kênh của bạn là FANPAGE (own_channel_type: page)
FB_PAGE_TOKEN=
# Trình duyệt cho Playwright: dùng Google Chrome thật (khuyên dùng để đăng nhập Google/Facebook ổn định)
FLOWAGENT_BROWSER_CHANNEL=chrome
# hoặc chỉ định đường dẫn: FLOWAGENT_BROWSER_PATH=/usr/bin/google-chrome
